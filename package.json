{
  "name": "sub-merger",
  "scripts": {
    "dev": "wrangler dev src/index.tsx --test-scheduled",
    "deploy": "wrangler deploy --minify src/index.tsx",
    "build": "wrangler deploy src/index.tsx --dry-run --outdir dist --name sub-merger --compatibility-date 2024-08-26 --compatibility-flags nodejs_compat",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:api": "vitest run test/integration",
    "test:compat": "vitest run test/compat"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "hono": "^4.5.8",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.10.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.113.0"
  }
}
